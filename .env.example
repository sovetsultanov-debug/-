# --- Server (never exposed to the browser) ---
# Anthropic API key for the AI travel agent. Without it the chat shows a
# "not connected yet" notice instead of answers.
ANTHROPIC_API_KEY=""
# Optional: override the Claude model (default: claude-opus-5-5)
# ANTHROPIC_MODEL="claude-opus-5-5"
# Port (Cloud Run sets this automatically)
# PORT=3000

# --- Browser (public, safe to expose) ---
# Supabase project URL and anon key. Without them the site runs in guest mode
# (chat works, but conversations are not saved).
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# --- Server-side Supabase access (required: chat needs sign-in) ---
# Service-role key: bypasses row-level security. Keep it SECRET, server only.
# Never prefix it with VITE_ (that would ship it to the browser).
SUPABASE_SERVICE_ROLE_KEY=""
# Optional: defaults to VITE_SUPABASE_URL
# SUPABASE_URL=""

# --- Admin panel (/admin) ---
# Comma-separated list of admin emails. The email must be confirmed in Supabase.
ADMIN_EMAILS=""
